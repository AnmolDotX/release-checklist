generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Release {
  id              Int      @id @default(autoincrement())
  name            String
  due_date        DateTime
  additional_info String?  @db.Text
  completed_steps Json
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("releases")
}
